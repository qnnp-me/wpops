# wpops 站点配置模板。
# 复制成 sites/<名字>.env,填入该站真实值。sites/*.env 已被 .gitignore 忽略,不会提交。
# 生成应用密码:WordPress 后台 → 用户 → 个人资料 → 应用程序密码 → 勾选 "Read/Write"

# 站点地址(必须 https,结尾不要带斜杠)
WP_URL=https://your-site.example.com

# 登录用户名
WP_USER=admin

# 应用密码(可带空格,原样粘贴)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 可选:请求与连接超时(毫秒),默认 30000
# WP_TIMEOUT_MS=30000

# 可选:失败重试次数与退避基数(毫秒),默认 2 次 / 500ms
# WP_RETRIES=2
# WP_RETRY_DELAY_MS=500

{
  "name": "wpops",
  "version": "0.1.1",
  "description": "WordPress REST operations toolkit — manage posts, pages, media, comments, users and plugins from the CLI. Multi-site, safety-first, zero dependencies.",
  "license": "MIT",
  "author": "qnnp",
  "type": "module",
  "bin": {
    "wpops": "bin/wpops.js"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "skills",
    ".env.example",
    "README.md"
  ],
  "keywords": [
    "wordpress",
    "wp",
    "rest-api",
    "wp-json",
    "cli",
    "application-password",
    "content-management",
    "multi-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qnnp-me/wpops.git"
  },
  "homepage": "https://github.com/qnnp-me/wpops#readme",
  "bugs": {
    "url": "https://github.com/qnnp-me/wpops/issues"
  },
  "scripts": {
    "setup": "node bin/wpops.js setup",
    "doctor": "node bin/wpops.js doctor",
    "help": "node bin/wpops.js help",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
